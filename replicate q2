# create anxiety measure. note that each produces a scale > .75,

# standardize identify groups
df <- q2 %>% 
  mutate(
    RACETHNICITY5 = case_when(
      RACETHNICITY == 1 ~ 1, # white,
      RACETHNICITY == 2 ~ 2, # black,
      RACETHNICITY == 4 ~ 3, # hispanic
      RACETHNICITY == 6 ~ 4, #asian
      RACETHNICITY %in% c(3, 5) ~ 5, # other
      TRUE ~ NA_real_
  ),
  PID3 = case_when( # 3 category partisanship 
    DOV_PARTY5ID %in% c(-1, 3) ~ 2, #independent, none
    DOV_PARTY5ID %in% c(1, 2) ~ 1, #dem, lean dem
    DOV_PARTY5ID %in% c(4, 5) ~ 3, #rep, lean rep
  ))

# rescale anxiety meausres to 0-1
df <- df %>%
  mutate(
    across(
      c(eco_anxiety_1:eco_anxiety_4,
        global_anxiety_1:global_anxiety_4,
        dom_anxiety_1:dom_anxiety_4),
      ~ .x -1, 
      .names = "{.col}_rc"
    ) 
  )

psych::alpha(
  df %>% select(eco_anxiety_1_rc:eco_anxiety_4_rc))
  
psych::alpha(
  df %>% select(global_anxiety_1_rc:global_anxiety_4_rc))

psych::alpha(
  df %>% select(dom_anxiety_1_rc:dom_anxiety_4_rc))

df <- df %>%
  mutate(
    eco_anxiety_mean = rowMeans(
      pick(eco_anxiety_1_rc:eco_anxiety_4_rc), 
    na.rm = TRUE),
    global_anxiety_mean = rowMeans(
      pick(global_anxiety_1_rc:global_anxiety_4_rc),
      na.rm = TRUE
    ),
    dom_anxiety_mean = rowMeans(
      pick(dom_anxiety_1_rc:dom_anxiety_4_rc),
      na.rm = TRUE
    )
  )

# descb stat
df %>%
  select(
    eco_anxiety_mean,
    global_anxiety_mean, 
    dom_anxiety_mean
  ) %>%
  psych::describe() %>%
  select(n, mean, sd, min, max)

#histograms 
