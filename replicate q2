# ANXIETY MEASURES A > .75. with the exceltption of gloa_anx_4, but it's fine


# analysis

df <- df %>%
  mutate(
    across(c(AGE4, RACETHNICITY5, PID3, GENDER, EDUC5, INCOME4), factor)
  )

design <- svydesign(
  ids = ~1,
  weights = ~weight_final,
  data = df
)

ivs <- c("nat_id1", "id2_mean", "chauv_mean", "US_attach")
dvs <- c(
  Eco = "eco_anxiety_mean",
  Global = "global_anxiety_mean",
  Dom = "dom_anxiety_mean",
  Infself = "inf_self_rc",
  `HH Job` = "jobloss_hh_rc",
  `Reg Job` = "jobloss_region_rc"
)

# Table 1: Nationalism -> Anxiety / Economic Concerns


results <- list()

for (iv in ivs) {
  for (j in seq_along(dvs)) {
    
    m <- svyglm(
      as.formula(
        paste(
          dvs[j], "~", iv,
          "+ AGE4 + RACETHNICITY5 + PID3 + GENDER + EDUC5 + INCOME4"
        )
      ),
      design = design
    )
    
    x <- broom::tidy(m) %>%
      filter(term == iv) %>%
      mutate(
        IV = iv,
        DV = names(dvs)[j]
      )
    
    results[[paste(iv, j)]] <- x
  }
}

results <- bind_rows(results)
table1 <- results %>%
  select(IV, DV, estimate, std.error, p.value) %>%
  pivot_longer(
    c(estimate, std.error, p.value),
    names_to = "stat",
    values_to = "value"
  ) %>%
  mutate(
    stat = recode(
      stat,
      estimate = "b",
      std.error = "se",
      p.value = "p"
    ),
    value = round(value, 2)
  ) %>%
  pivot_wider(
    names_from = c(DV, stat),
    values_from = value
  )

table1

# demographics -> nationalism measures
m1 <- svyglm(nat_id1 ~ AGE4 + RACETHNICITY5 + PID3 + GENDER + EDUC5 + INCOME4,
             design = design)

m2 <- svyglm(id2_mean ~ AGE4 + RACETHNICITY5 + PID3 + GENDER + EDUC5 + INCOME4,
             design = design)

m3 <- svyglm(chauv_mean ~ AGE4 + RACETHNICITY5 + PID3 + GENDER + EDUC5 + INCOME4,
             design = design)

m4 <- svyglm(US_attach ~ AGE4 + RACETHNICITY5 + PID3 + GENDER + EDUC5 + INCOME4,
             design = design)

modelsummary(
  list(
    "ID1" = m1,
    "ID2" = m2,
    "Chauv" = m3,
    "US Attachment" = m4
  ),
  estimate = "{estimate}",
  statistic = c("se" = "{std.error}", "p" = "{p.value}"),
  fmt = 2,
  output = "html"
)
